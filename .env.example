# Database Config
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=


# Encryption Keys
API_DEBUG_KEY=
ENCRYPTION_KEY=
API_ENCRYPTION_KEY=


# Client Authentication
# Generate with: php scripts/generate_api_credentials.php
WPF_APP_API_KEY=
WPF_APP_API_SECRET=


# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE=database  # Options: database, redis, apcu
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=


# Security
SIGNATURE_MAX_AGE_SECONDS=300  # 5 minutes
REQUEST_AUDIT_ENABLED=true
DEVICE_REGISTRATION_REQUIRED=false


# Production Settings
APP_ENV=development  # development, staging, production
LOG_LEVEL=warning   # debug, info, warning, error